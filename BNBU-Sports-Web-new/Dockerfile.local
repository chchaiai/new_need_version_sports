FROM node:24.18.0-bookworm-slim AS student
WORKDIR /app/frontend
COPY --chown=node:node frontend/preview-server.cjs ./
COPY --chown=node:node frontend/student/index.html ./student/
COPY --chown=node:node frontend/student/assets/ ./student/assets/
COPY --chown=node:node frontend/student/css/ ./student/css/
COPY --chown=node:node frontend/student/js/ ./student/js/
ENV HOST=0.0.0.0
ENV PORT=4174
USER node
EXPOSE 4174
HEALTHCHECK --interval=10s --timeout=5s --start-period=10s --retries=12 CMD ["node", "-e", "fetch('http://127.0.0.1:4174/student/').then((response)=>{if(!response.ok)process.exit(1)}).catch(()=>process.exit(1))"]
CMD ["node", "preview-server.cjs"]

# Immutable static carrier for the host-Nginx Staging topology. The generated
# file contains only the public allowlisted app environment exposed by the preview
# server and is extracted into the release's student/ directory at deploy time.
FROM student AS student-staging
ARG OCI_VERSION
ARG OCI_REVISION
ARG OCI_CREATED
ARG BNBU_CONTRACT_VERSION
ARG BNBU_WORKTREE_FINGERPRINT
ARG BNBU_TEST_BATCH
ARG BNBU_PUBLIC_APP_ENV=staging
RUN test -n "$OCI_VERSION" \
    && test -n "$OCI_REVISION" \
    && test -n "$OCI_CREATED" \
    && test -n "$BNBU_CONTRACT_VERSION" \
    && test -n "$BNBU_WORKTREE_FINGERPRINT" \
    && test -n "$BNBU_TEST_BATCH" \
    && APP_ENV="$BNBU_PUBLIC_APP_ENV" \
    node -e "const fs=require('node:fs');const runtime=require('./preview-server.cjs');if(process.env.APP_ENV!=='staging')throw new Error('student-staging requires APP_ENV=staging');fs.writeFileSync('student/runtime-config.js',runtime.runtimeConfigScript(process.env),{encoding:'utf8',mode:0o644,flag:'wx'});"

LABEL org.opencontainers.image.title="BNBU Sports Student Static Carrier" \
      org.opencontainers.image.version="$OCI_VERSION" \
      org.opencontainers.image.revision="$OCI_REVISION" \
      org.opencontainers.image.created="$OCI_CREATED" \
      org.opencontainers.image.source="BNBU-Sports monorepo" \
      bnbu.contract.version="$BNBU_CONTRACT_VERSION" \
      bnbu.worktree.fingerprint="$BNBU_WORKTREE_FINGERPRINT" \
      bnbu.test.batch="$BNBU_TEST_BATCH" \
      bnbu.environment="staging" \
      bnbu.environment.candidate="staging"

FROM node:24.18.0-bookworm-slim AS portal-dependencies
WORKDIR /app
RUN chown node:node /app
USER node
COPY --chown=node:node portal-teacher-admin/package.json portal-teacher-admin/package-lock.json ./
RUN npm ci

FROM portal-dependencies AS portal
COPY --chown=node:node portal-teacher-admin/ ./
ENV WRANGLER_WRITE_LOGS=false
ENV WRANGLER_LOG_PATH=/tmp/wrangler/logs
ENV MINIFLARE_REGISTRY_PATH=/tmp/wrangler/registry
EXPOSE 3001
HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=12 CMD ["node", "-e", "fetch('http://127.0.0.1:3001/').then((response)=>{if(!response.ok)process.exit(1)}).catch(()=>process.exit(1))"]
CMD ["npm", "run", "dev", "--", "--port", "3001", "--strictPort"]
