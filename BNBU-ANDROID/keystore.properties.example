# Copy this file to keystore.properties on a protected developer machine.
# Never commit keystore.properties or the referenced .jks file.
#
# CI should set the same four names as protected environment variables instead.
BNBU_RELEASE_STORE_FILE=release/bnbu-upload.jks
BNBU_RELEASE_STORE_PASSWORD=
BNBU_RELEASE_KEY_ALIAS=bnbu-upload
BNBU_RELEASE_KEY_PASSWORD=
