    <string name="privacy_consent_eyebrow">BNBU SPORTS</string>
    <string name="privacy_consent_title">Before you begin</string>
    <string name="privacy_consent_intro">Please read and accept the Privacy Policy. We use information only as needed to provide your sports education service.</string>
    <string name="privacy_consent_summary_title">How we use your information</string>
    <string name="privacy_consent_summary">To provide sports education services, we process your student ID, name, courses, grades, and activity check-in records. Camera and microphone access records on-site video with audio only when you choose that feature; active recording is limited to 15 seconds, compressed on-device, and uploaded only after compression succeeds and you submit. Selected media is used only when chosen; the current app does not request location permission or collect coordinates. Notifications use Firebase Cloud Messaging installation identifiers and push tokens. This information is not used for advertising or personalised recommendations.</string>
    <string name="privacy_consent_full_policy">Read the full Privacy Policy</string>
    <string name="privacy_consent_agree">Agree and continue</string>
    <string name="privacy_consent_decline">Disagree and exit</string>
    <string name="privacy_consent_footer">After agreeing, you can review the latest version anytime in Profile — Privacy Policy.</string>

