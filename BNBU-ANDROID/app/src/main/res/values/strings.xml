    <string name="privacy_consent_eyebrow">BNBU SPORTS</string>
    <string name="privacy_consent_title">开始使用前，请确认</string>
    <string name="privacy_consent_intro">请阅读并同意隐私政策。我们会以清晰、必要的方式处理信息，为你提供体育教学服务。</string>
    <string name="privacy_consent_summary_title">我们如何处理你的信息</string>
    <string name="privacy_consent_summary">为完成体育教学服务，我们会处理学号、姓名、课程、运动打卡、原始体测和计入进度。仅在你主动使用相关功能时调用相机和麦克风录制含声音的现场视频、读取你选择的图片或视频；当前版本不申请定位权限或采集经纬度。视频累计录制最多 15 秒并在本机压缩，只有压缩成功且你明确提交后才上传。学生业务提醒通过应用内通知中心展示。上述信息不用于广告或个性化推荐。</string>
    <string name="privacy_consent_full_policy">查看完整隐私政策</string>
    <string name="privacy_consent_agree">同意并继续</string>
    <string name="privacy_consent_decline">不同意并退出</string>
    <string name="privacy_consent_footer">同意后，你仍可在“我的 — 隐私政策”中随时查看最新版本。</string>

